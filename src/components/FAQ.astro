---
const faqs = [
	{
		title: "Koster Nembadminton noget at bruge?",
		description: "Nej. Nembadminton er gratis at bruge. Projektet drives på frivillig basis for at gøre arbejdet med klubbens hold lettere."
	},
	{
		title: "Er Nembadminton relevant for min klub?",
		description: "Nembadminton er til trænere og frivillige, der sætter klubbens hold. Regeltjek tager udgangspunkt i DH-turneringen. Spiller I i regionale serier, skal I være opmærksomme på deres egne regler og kampformater."
	},
	{
		title: "Hvordan kommer vi i gang?",
		description: 'Opret en bruger, tilknyt klubben til dit klubhus, og klargør en holdrunde med klubbens hold. <a href="https://app.nembadminton.dk/app/help/guides/opret-og-klargoer-en-holdrunde">Kom i gang med en holdrunde</a> i den offentlige Hjælp.',
	},
	{
		title: "Hvor kommer spillerdata fra?",
		description: 'Nembadminton henter spillere og ranglistepoint fra badmintonplayer.dk. Badminton Danmark har gjort data tilgængelige, og der er indgået en databehandleraftale. Dataadgangen betyder ikke, at Badminton Danmark har kontrolleret eller godkendt Nembadmintons beregninger. <a href="https://app.nembadminton.dk/app/help/about">Læs om projektet og dataadgangen</a>.',
	},
	{
		title: "Kan vi stole på, at en opstilling med OK er korrekt?",
		description: 'Kontrollerne hjælper med understøttede regler i DH-turneringen. Et OK er ikke en garanti for, at opstillingen overholder alle gældende regler. Det er stadig klubbens og trænerens ansvar at kontrollere opstillingen, blandt andet placeringen af ungdomsspillere. <a href="https://app.nembadminton.dk/app/help/guides/lav-og-kontroller-den-officielle-holdopstilling">Læs om kontroller og begrænsninger</a>.',
	},
	{
		title: "Hvor finder jeg hjælp, hvis noget driller?",
		description: 'Den offentlige Hjælp har vejledninger om blandt andet manglende spillere, ranglister og kontrol af opstillinger. <a href="https://app.nembadminton.dk/app/help/faq">Find svar og fejlhjælp</a>, eller <a href="https://app.nembadminton.dk/app/help/guides">se alle vejledninger</a>. Du kan læse dem uden at logge ind.',
	}
];
---

<div class="bg-white py-24 sm:py-32" id="faq">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-4xl divide-y divide-gray-900/10">
      <h2 class="text-2xl font-bold leading-10 tracking-tight text-gray-900">Ofte stillede spørgsmål</h2>
      <dl class="mt-10 space-y-6 divide-y divide-gray-900/10">
        {faqs.map((faq, index) => (
          <div class="pt-6">
            <dt>
              <button 
                type="button" 
                class="flex w-full items-start justify-between text-left text-gray-900 faq-button"
                aria-controls={`faq-${index}`}
                id={`faq-question-${index}`}
                aria-expanded="false"
                onclick={`toggleFAQ(${index})`}
              >
                <span class="text-base font-semibold leading-7">{faq.title}</span>
                <span class="ml-6 flex h-7 items-center">
                  <svg class="h-6 w-6 transform transition-transform duration-200 faq-icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6" />
                  </svg>
                </span>
              </button>
            </dt>
            <dd class="mt-2 pr-12 hidden faq-answer" id={`faq-${index}`} role="region" aria-labelledby={`faq-question-${index}`}>
              <div class="text-base leading-7 text-gray-600" set:html={faq.description}></div>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</div>

<script is:inline>
  function toggleFAQ(index) {
    const answer = document.getElementById(`faq-${index}`);
    const button = answer?.previousElementSibling?.querySelector('.faq-button');
    const icon = button?.querySelector('.faq-icon');
    
    if (answer && button && icon) {
      const isOpen = answer.classList.contains('hidden');
      
      if (isOpen) {
        answer.classList.remove('hidden');
        button.setAttribute('aria-expanded', 'true');
        icon.style.transform = 'rotate(45deg)';
      } else {
        answer.classList.add('hidden');
        button.setAttribute('aria-expanded', 'false');
        icon.style.transform = 'rotate(0deg)';
      }
    }
  }
</script>

<style>
  .faq-answer :global(a) {
    color: #2563eb;
    text-decoration: underline;
  }
  
  .faq-answer :global(a:hover) {
    color: #3b82f6;
  }
</style>
